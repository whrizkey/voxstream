# VoxStream Configuration Template
# Copy this file to .env to customize settings.

# --- Provider Selection ---
# STT: faster_whisper | openai_compat | fake
VOXSTREAM_STT_PROVIDER=faster_whisper
# Translate: openai_compat | anthropic | deepl | fake
VOXSTREAM_TRANSLATE_PROVIDER=openai_compat
# TTS: edge | openai | elevenlabs | piper | fake
VOXSTREAM_TTS_PROVIDER=edge

# --- API Keys & Endpoints (Cloud Providers) ---
# OpenAI or compatible endpoints (Ollama, LM Studio, Groq, OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# DeepL
DEEPL_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=

# --- Model Overrides ---
# Whisper model size (tiny, base, small, medium, large-v3) or API model name
VOXSTREAM_STT_MODEL=small
# LLM translation model (e.g. gpt-4o-mini, claude-3-5-haiku, llama3.1)
VOXSTREAM_TRANSLATE_MODEL=gpt-4o-mini
# TTS voice name or ID override (empty uses provider defaults per language)
VOXSTREAM_TTS_VOICE=

# --- Pipeline & Playback Tuning ---
# Seconds of audio to process ahead of the video playhead
VOXSTREAM_LOOKAHEAD_SECONDS=120
# Seconds of pre-buffered content required before playback begins
VOXSTREAM_INITIAL_BUFFER_SECONDS=20
# Nominal chunk processing slice duration in seconds
VOXSTREAM_CHUNK_SECONDS=30
# Overlap padding added to both sides of chunks for acoustic/linguistic context
VOXSTREAM_CHUNK_OVERLAP_SECONDS=2
# Maximum pitch-preserving speedup factor allowed when squeezing synthesized audio
VOXSTREAM_MAX_SPEEDUP=1.25
# Volume attenuation (in dB) applied to the original video audio track while dubbing
VOXSTREAM_DUCK_DB=-14
# Pause video automatically if playhead catches up to unprocessed chunks
VOXSTREAM_PAUSE_ON_UNDERRUN=true
# Cache directory for audio segments, SQLite index, and model weights (empty uses OS default)
VOXSTREAM_CACHE_DIR=
